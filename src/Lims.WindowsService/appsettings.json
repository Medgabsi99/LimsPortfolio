{
  "ConnectionStrings": {
    "LimsDb": "Server=(localdb)\\MSSQLLocalDB;Database=LimsDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "InstrumentImport": {
    "IncomingFolder": "C:\\Lims\\InstrumentData\\incoming",
    "ArchiveFolder": "C:\\Lims\\InstrumentData\\archive",
    "ErrorFolder": "C:\\Lims\\InstrumentData\\error",
    "FilePattern": "*.csv",
    "PollIntervalSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Lims": "Debug"
    }
  },
  "EventLog": {
    "SourceName": "LimsInstrumentImport",
    "LogLevel": {
      "Default": "Warning"
    }
  }
}