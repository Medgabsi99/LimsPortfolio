# ============================================================
# LIMS — Required environment variables (production servers)
# ============================================================
# Copy this file and rename it .env — never commit .env to git.
# On Windows Server: set these as Machine-scope env vars via:
#   [Environment]::SetEnvironmentVariable('KEY','VALUE','Machine')
# On Azure App Service: add them as Application Settings.

# ── REST API ──────────────────────────────────────────────────
# Minimum 32-character random string (Base64 recommended).
# Generate: [Convert]::ToBase64String((1..32|%{[byte](Get-Random -Max 256)}))
Jwt__SigningKey=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── SOAP Service ──────────────────────────────────────────────
# Must match the value configured in any client calling the SOAP endpoint.
# Generate with the same command above.
SoapService__ApiKey=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Database (if not using Trusted_Connection / Windows Auth) ─
# ConnectionStrings__LimsDb=Server=prod-sql;Database=LimsDb;User Id=lims_app;Password=REPLACE;TrustServerCertificate=False;

# ── TLS certificate paths (Kestrel direct hosting, optional) ──
# LIMS_CERT_PATH=/etc/ssl/lims/server.crt
# LIMS_CERT_KEY_PATH=/etc/ssl/lims/server.key
